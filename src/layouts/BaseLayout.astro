---
import "@fontsource/fira-sans/400.css";
import "@fontsource/fira-sans/700.css";
import "@fontsource/fira-sans/900.css";
import "../styles/global.css";
import { basePath } from "../lib/charts";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Entre Hits",
  description = "Lista semanal y anual de éxitos nacionales e internacionales del programa Entre Mezclas de Radio Holguín La Nueva.",
  canonical,
  image,
} = Astro.props;
const pageTitle = title === "Entre Hits" ? title : `${title} | Entre Hits`;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : Astro.url;
const imageUrl = image ? new URL(image, Astro.site) : undefined;
const currentPath = Astro.url.pathname;
const navigation = [
  { label: "Semanal", href: `${basePath}/semanal/nacional/`, section: "/semanal/" },
  { label: "Anual", href: `${basePath}/anual/nacional/`, section: "/anual/" },
  { label: "Archivo", href: `${basePath}/archivo/`, section: "/archivo/" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Entre Hits" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${basePath}/favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="site-wordmark" href={`${basePath}/`} aria-label="Entre Hits, inicio">
        <span>ENTRE</span><strong>HITS</strong>
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        {navigation.map((item) => (
          <a
            href={item.href}
            class:list={{ active: currentPath.includes(item.section) }}
            aria-current={currentPath.includes(item.section) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        class="live-link"
        href="https://icecast.teveo.cu/dn9JTKtH"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="live-dot" aria-hidden="true"></span>
        <span class="live-label">Escuchar CMKE en vivo</span>
        <span class="live-short" aria-hidden="true">En vivo</span>
      </a>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-identity">
          <img src={`${basePath}/brand/entre-mezclas.png`} alt="Entre Mezclas" width="76" height="76" />
          <div>
            <p class="footer-wordmark"><span>ENTRE</span> HITS</p>
            <p>La lista de éxitos del programa Entre Mezclas de Radio Holguín La Nueva.</p>
          </div>
        </div>
        <nav class="footer-nav" aria-label="Navegación secundaria">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="https://icecast.teveo.cu/dn9JTKtH" target="_blank" rel="noopener noreferrer">CMKE en vivo</a>
        </nav>
        <p class="footer-legal">© 2026 Radio Holguín La Nueva. Contenido editorial y elementos de marca: todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
