---
interface Props {
  title: string;
  youtube?: string;
  spotify?: string;
  variant?: "compact" | "detail";
}

interface PlatformLink {
  href: string;
  platform: "youtube" | "spotify";
  visibleLabel: string;
  accessibleLabel: string;
}

const { title, youtube, spotify, variant = "compact" } = Astro.props;
const links: PlatformLink[] = [];

if (youtube) {
  links.push({
    href: youtube,
    platform: "youtube",
    visibleLabel: variant === "detail" ? "Ver en YouTube" : "YouTube",
    accessibleLabel: `Ver ${title} en YouTube (abre en una pestaña nueva)`,
  });
}

if (spotify) {
  links.push({
    href: spotify,
    platform: "spotify",
    visibleLabel: variant === "detail" ? "Escuchar en Spotify" : "Spotify",
    accessibleLabel: `Escuchar ${title} en Spotify (abre en una pestaña nueva)`,
  });
}
---

{links.length > 0 && (
  <div class:list={["platform-links", `platform-links--${variant}`]} role="group" aria-label={`Plataformas para ${title}`}>
    {links.map((link) => (
      <a
        class="platform-link"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.accessibleLabel}
      >
        {link.platform === "youtube" ? (
          <svg class="platform-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5A3.02 3.02 0 0 0 23.5 17.81C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.55 15.75v-7.5L15.82 12l-6.27 3.75Z" />
          </svg>
        ) : (
          <svg class="platform-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm5.49 17.31a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.11-10.54-1.16a.75.75 0 0 1-.34-1.46c4.57-1.04 8.5-.59 11.66 1.34.35.22.46.68.25 1.03Zm1.37-3.05a.94.94 0 0 1-1.29.31c-3.22-1.98-8.14-2.56-11.95-1.4a.94.94 0 1 1-.55-1.79c4.37-1.32 9.79-.68 13.49 1.59.44.27.58.85.3 1.29Zm.12-3.18C15.11 8.79 8.73 8.58 5.04 9.7a1.12 1.12 0 1 1-.65-2.15c4.23-1.29 11.28-1.04 15.74 1.61a1.12 1.12 0 0 1-1.15 1.92Z" />
          </svg>
        )}
        <span>{link.visibleLabel}</span>
        <svg class="platform-link-external" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="m5 11 6-6M6 5h5v5" />
        </svg>
      </a>
    ))}
  </div>
)}
