---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartBoard from "./ChartBoard.astro";
import DateCalendar from "./DateCalendar.astro";
import type { AnnualChart, Category, WeeklyEdition } from "../lib/charts";
import {
  annualPath,
  annualCharts,
  basePath,
  categoryLabels,
  categorySlugs,
  formatDate,
  getAdjacentEditions,
  imagePath,
  songsById,
  weeklyEditions,
  weeklyPath,
} from "../lib/charts";

type Props = {
  variant: "weekly";
  category: Category;
  edition: WeeklyEdition;
  autoCurrent?: boolean;
} | {
  variant: "annual";
  category: Category;
  annual: AnnualChart;
  autoCurrent?: false;
};

const props = Astro.props as Props;
const { variant, category, autoCurrent = false } = props;
const edition = props.variant === "weekly" ? props.edition : undefined;
const annual = props.variant === "annual" ? props.annual : undefined;
const label = categoryLabels[category];
const otherCategory: Category = category === "national" ? "international" : "national";
const getSong = (songId: string) => {
  const song = songsById.get(songId);
  if (!song) throw new Error(`Chart references missing song ${songId}`);
  return song;
};
const entries = props.variant === "weekly"
  ? props.edition.charts[category].map((entry) => ({ ...entry, song: getSong(entry.songId) }))
  : props.annual.entries.map((entry) => ({ ...entry, song: getSong(entry.songId) }));
const adjacent: { previous?: WeeklyEdition; next?: WeeklyEdition } = edition
  ? getAdjacentEditions(edition.date)
  : {};
const annualYears = [...new Set(annualCharts.map((chart) => chart.year))].sort((a, b) => b - a);
const title = props.variant === "weekly"
  ? `Lista #${props.edition.number} ${label} · ${formatDate(props.edition.date)}`
  : `Top 20 ${label} · Cierre ${props.annual.year}`;
const download = props.variant === "weekly"
  ? imagePath("semanal", category, props.edition.date)
  : imagePath("anual", category, props.annual.year);
const switchPath = props.variant === "weekly"
  ? weeklyPath(otherCategory, props.edition.date)
  : annualPath(otherCategory, props.annual.year);
const currentCategoryPath = props.variant === "weekly"
  ? weeklyPath(category, props.edition.date)
  : annualPath(category, props.annual.year);
const weeklyTabPath = variant === "weekly" ? currentCategoryPath : weeklyPath(category);
const annualTabPath = variant === "annual" ? currentCategoryPath : annualPath(category);
---

<BaseLayout title={title} image={download}>
  <div class:list={["chart-page", `chart-page--${category}`]}>
  <div class="page-shell">
    <div class="edition-kicker">
      <p>{variant === "weekly" ? "Lista semanal" : "Cierre anual"}</p>
      <p>Entre Mezclas · Radio Holguín La Nueva</p>
    </div>

    <nav class="variant-tabs" aria-label="Tipo de lista">
      <a class:list={{ active: variant === "weekly" }} href={weeklyTabPath} aria-current={variant === "weekly" ? "page" : undefined}>Semanal</a>
      <a class:list={{ active: variant === "annual" }} href={annualTabPath} aria-current={variant === "annual" ? "page" : undefined}>Anual</a>
    </nav>

    <div class="chart-toolbar">
      <nav class="category-tabs" aria-label="Categoría">
        <a class:list={{ active: category === "national" }} href={category === "national" ? currentCategoryPath : switchPath} aria-current={category === "national" ? "page" : undefined}>Nacional</a>
        <a class:list={{ active: category === "international" }} href={category === "international" ? currentCategoryPath : switchPath} aria-current={category === "international" ? "page" : undefined}>Internacional</a>
      </nav>
      <a class="download-link" href={download} download>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M4 17v3h16v-3"/></svg>
        Descargar imagen
      </a>
    </div>

    {variant === "weekly" && edition && (
      <DateCalendar
        category={category}
        current={edition}
        editions={weeklyEditions}
        previous={adjacent.previous}
        next={adjacent.next}
      />
    )}

    {variant === "annual" && annual && (
      <nav class="year-navigation" aria-label="Seleccionar cierre anual">
        {annualYears.map((year) => (
          <a class:list={{ active: year === annual.year }} href={annualPath(category, year)} aria-current={year === annual.year ? "page" : undefined}>{year}</a>
        ))}
      </nav>
    )}

    {variant === "weekly" && (
      <p class="chart-legend" aria-label="Leyenda de columnas">
        <span><b>L</b> Lugar</span>
        <span><b>S</b> Semanas</span>
        <span><b>▲ ▼</b> Movimiento</span>
      </p>
    )}

    <div id="chart" class="chart-frame">
      <ChartBoard
        category={category}
        variant={variant}
        entries={entries}
        date={edition?.date}
        number={edition?.number}
        year={annual?.year}
      />
    </div>

    <div class="after-chart">
      <a href={`${basePath}/archivo/`}>Explorar el archivo completo</a>
      <p>Autores y enlaces se incorporan progresivamente a partir de fuentes verificadas.</p>
    </div>
  </div>
  </div>

  {autoCurrent && edition && (
    <script
      is:inline
      define:vars={{
        editions: weeklyEditions.map(({ date }) => date),
        currentDate: edition.date,
        routeBase: `${basePath}/semanal/${categorySlugs[category]}`,
      }}
    >
      (() => {
        const parts = new Intl.DateTimeFormat("en-CA", {
          year: "numeric", month: "2-digit", day: "2-digit", weekday: "short", timeZone: "America/Havana",
        }).formatToParts(new Date());
        const part = (type) => parts.find((item) => item.type === type)?.value || "";
        const date = new Date(`${part("year")}-${part("month")}-${part("day")}T12:00:00Z`);
        const index = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(part("weekday"));
        date.setUTCDate(date.getUTCDate() - Math.max(index, 0));
        const weekStart = date.toISOString().slice(0, 10);
        const target = [...editions].reverse().find((entry) => entry <= weekStart) || editions[0];
        if (target && target !== currentDate) window.location.replace(`${routeBase}/${target}/`);
      })();
    </script>
  )}
</BaseLayout>
