---
import BaseLayout from "../layouts/BaseLayout.astro";
import { annualCharts, annualPath, formatDate, weeklyEditions, weeklyPath } from "../lib/charts";

const years = [...new Set(weeklyEditions.map((edition) => edition.year))].sort((a, b) => b - a);
const annualYears = [...new Set(annualCharts.map((chart) => chart.year))].sort((a, b) => b - a);
---

<BaseLayout title="Archivo">
  <div class="archive-shell">
    <header class="archive-header">
      <p>Archivo editorial</p>
      <h1>Todos los conteos.<br /><span>Una historia semanal.</span></h1>
      <p>Consulta las ediciones disponibles de Entre Hits. Los domingos sin programa no generan una página vacía.</p>
    </header>

    <section class="annual-archive" aria-labelledby="annual-title">
      <div>
        <p class="section-number">01</p>
        <h2 id="annual-title">Cierres anuales</h2>
      </div>
      <div class="annual-cards">
        {annualYears.map((year) => (
          <article>
            <strong>{year}</strong>
            <a href={annualPath("national", year)}>Nacional</a>
            <a href={annualPath("international", year)}>Internacional</a>
          </article>
        ))}
      </div>
    </section>

    <section class="weekly-archive" aria-labelledby="weekly-title">
      <div class="archive-section-title">
        <p class="section-number">02</p>
        <h2 id="weekly-title">Conteos semanales</h2>
        <p>{weeklyEditions.length} ediciones disponibles</p>
      </div>
      {years.map((year) => (
        <details open={year === years[0]}>
          <summary><strong>{year}</strong><span>{weeklyEditions.filter((edition) => edition.year === year).length} conteos</span></summary>
          <ol>
            {weeklyEditions.filter((edition) => edition.year === year).reverse().map((edition) => (
              <li>
                <span>#{edition.number}</span>
                <time datetime={edition.date}>{formatDate(edition.date, { month: "short" })}</time>
                <a href={weeklyPath("national", edition.date)}>Nacional</a>
                <a href={weeklyPath("international", edition.date)}>Internacional</a>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </section>
  </div>
</BaseLayout>
