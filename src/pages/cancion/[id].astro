---
import SongPerformance from "../../components/SongPerformance.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { basePath, formatArtistCredit, formatNames, getSongHistories, songPath, songs, type Song, type SongChartHistory } from "../../lib/charts";

export function getStaticPaths() {
  return songs.flatMap((song) => {
    const histories = getSongHistories(song.id);
    return histories.length ? [{ params: { id: song.id }, props: { song, histories } }] : [];
  });
}

interface Props {
  song: Song;
  histories: SongChartHistory[];
}

const { song, histories } = Astro.props;
const primaryCategory = histories[0]?.category ?? "international";
const appearances = histories.reduce((total, history) => total + history.appearances.length, 0);
const artistCredit = formatArtistCredit(song);
const description = `Historial de ${song.title} por ${artistCredit}: posiciones y desempeño en ${appearances} conteos de Entre Hits.`;
const versionLabel = song.versionType === "remix" ? "Remezcla" : "Versión";
const versionDescription = song.versionType === "remix"
  ? song.versionName && !song.remixers?.includes(song.versionName) ? `Remezcla ${song.versionName}` : "Remezcla"
  : song.versionName ? `Versión ${song.versionName}` : "Versión";
---

<BaseLayout title={`${song.title} · Historial`} description={description} canonical={songPath(song.id)}>
  <div class:list={["song-page", `song-page--${primaryCategory}`]}>
    <div class="song-shell">
      <nav class="song-breadcrumb" aria-label="Ruta de navegación">
        <a href={`${basePath}/archivo/`}>Archivo</a><span aria-hidden="true">/</span><span>Historial de canción</span>
      </nav>

      <header class="song-header">
        <p>Desempeño en Entre Hits</p>
        <h1>{song.title}</h1>
        <p class="song-page-artists">{artistCredit}</p>
        {song.authors && <p class="song-page-meta song-page-authors"><strong>Autoría:</strong> {formatNames(song.authors)}</p>}
        {song.versionType && <p class="song-page-meta"><strong>Tipo:</strong> {versionDescription}</p>}
        {song.remixers && <p class="song-page-meta"><strong>Remezcla:</strong> {formatNames(song.remixers)}</p>}
        {song.versionStatus && <p class="song-page-meta"><strong>Estado:</strong> {versionLabel} {song.versionStatus === "independent" ? "independiente" : song.versionStatus}</p>}
        {song.sourceName && (
          <p class="song-page-meta">
            <strong>Fuente:</strong>{" "}
            {song.sourceUrl
              ? <a href={song.sourceUrl} target="_blank" rel="noopener noreferrer">{song.sourceName}</a>
              : song.sourceName}
          </p>
        )}
        {(song.sourceName || song.versionType) && song.sourceTitle !== song.title && <p class="song-page-meta"><strong>Título en la fuente:</strong> <cite>{song.sourceTitle}</cite></p>}
        {(song.youtube || song.spotify) && (
          <div class="song-page-links">
            {song.youtube && <a href={song.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>}
            {song.spotify && <a href={song.spotify} target="_blank" rel="noopener noreferrer">Spotify</a>}
          </div>
        )}
      </header>

      {histories.map((history) => <SongPerformance song={song} history={history} />)}

      <div class="song-page-return">
        <a href={`${basePath}/archivo/`}>Explorar todos los conteos</a>
      </div>
    </div>
  </div>
</BaseLayout>
